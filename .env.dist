PORT=3000
LOG_LEVEL=trace
DISABLE_REQUEST_LOGGING=true

# Mount della share dei media. In produzione e' in sola lettura.
MEDIA_ROOT=/data/photos

# Protegge le rotte /api/internal/* usate dai cron
BEARER_TOKEN=

# Firma il cookie di sessione: almeno 32 caratteri casuali (openssl rand -hex 32).
SESSION_SECRET=
# Durata del cookie di sessione in secondi: 90 giorni.
SESSION_TIMEOUTSECS=7776000

# Origini ammesse dal CORS, separate da virgola (serve al dev server di Vite)
CORS_ORIGINS=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGDATABASE=photovault
PGUSER=photovault
PGPASSWORD=

# Il pool libuv di default ha 4 thread e ogni lettura su CIFS ne occupa uno per
# millisecondi: con 4 una griglia da 200 thumbnail si serializza in uno stallo.
UV_THREADPOOL_SIZE=16
